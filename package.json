{
  "name": "rsr-office-playwright",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:local:smoke": "cross-env TEST_ENV=local playwright test --grep @smoke",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:uat:smoke": "cross-env TEST_ENV=uat playwright test --grep @smoke",
    "test:beta": "cross-env TEST_ENV=beta playwright test",
    "test:beta:smoke": "cross-env TEST_ENV=beta playwright test --grep @smoke",
    "test:production": "cross-env TEST_ENV=production playwright test",
    "test:production:smoke": "cross-env TEST_ENV=production playwright test --grep @smoke",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "rsr:open": "node scripts/open-rsr-report.js",
    "clean": "node -e \"['allure-results','allure-report','playwright-report','test-results','rsr-report'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.9",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2"
  }
}
